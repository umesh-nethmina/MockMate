# Copy to backend/.env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Production: a random string of 32+ characters (the app refuses to start otherwise)
JWT_SECRET=
# Accounts registered with these emails become administrators
ADMIN_EMAILS=[]
ENVIRONMENT=development
DATABASE_URL=sqlite:///./mockmate.db
CORS_ORIGINS=["http://localhost:5173"]
DAILY_COST_CAP_USD=5.0
# true = canned interviewer for local UI testing, no API key needed
USE_FAKE_LLM=false
